<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Archivo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/archivo_background</item>
        <item name="colorPrimary">@color/archivo_green</item>
        <item name="android:colorPrimary">@color/archivo_green</item>
    </style>

    <!-- Green brand splash — Android 12+ attributes + compat SplashScreen. -->
    <style name="Theme.Archivo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Archivo</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
    </style>
</resources>
